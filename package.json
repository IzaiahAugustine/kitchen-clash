{
  "name": "dinkzilla",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "models": "node tools/build-models.mjs",
    "build:crazygames": "tsc --noEmit && VITE_PORTAL=crazygames vite build --outDir dist-crazygames",
    "deploy": "npm run build && npx -y firebase-tools@13 deploy --only hosting:game,hosting:legacy"
  },
  "description": "Dinkzilla — an arcade-style 3D pickleball game for the browser",
  "dependencies": {
    "firebase": "^11.10.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "type": "module"
}
